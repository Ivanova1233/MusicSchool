<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MusicSchool.Views.MainWindow"
        Title="Музыкальная школа" Width="1100" Height="700" MinWidth="850" MinHeight="600">

    <DockPanel>
        <!-- 1. Шапка: логотип и ФИО пользователя -->
        <Border DockPanel.Dock="Top" Padding="16" Background="#D2F6EF">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="Музыкальная школа" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" />
                <TextBlock x:Name="UserText" Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="Black" />
            </Grid>
        </Border>

        <!-- 2. Кнопки навигации -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8">
            <Button x:Name="BackButton" Content="Назад" Click="BackClick" />
            <Button Content="Каталог программ" Click="CatalogClick" />
            <Button x:Name="OrdersButton" Content="Заявки" Click="OrdersClick" />
            <Button x:Name="TeacherGroupsButton" Content="Мои группы" Click="TeacherGroupsClick" />
            <Button Content="Сменить пользователя" Click="LogoutClick" />
        </StackPanel>

        <!-- 3. Строка для вывода сообщений и ошибок -->
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" Margin="16,4" Foreground="#FF0000" />

        <!-- 4. Место, куда будут загружаться страницы -->
        <ContentControl x:Name="PageHost" Margin="16" />
    </DockPanel>

</Window>