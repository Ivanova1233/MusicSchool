<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MusicSchool.Views.LoginView">
    <StackPanel Spacing="16" MaxWidth="500" HorizontalAlignment="Left">
        <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Выберите пользователя из базы данных:" />
        
        <ComboBox x:Name="UsersBox" HorizontalAlignment="Stretch" PlaceholderText="Загрузка..." MinHeight="40" />
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Войти" Click="LoginClick" Background="#70B2AF" Foreground="White" FontWeight="Bold" />
            <Button Content="Войти как гость" Click="GuestClick" />
        </StackPanel>
    </StackPanel>
</UserControl>